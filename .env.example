# 硅基流动（或任意 OpenAI 兼容接口）配置
# 线上部署（如魔搭创空间 Secrets）优先读取系统环境变量，本地开发回退到 .env
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 服务监听端口（魔搭创空间默认 7860）
PORT=7860

# 可选：飞书 / 钉钉 / 企业微信 Webhook 地址，留空则走简报预览模式
WEBHOOK_URL=

# 全局每日 LLM 调用上限（防止公开演示额度被刷爆）
DAILY_LLM_BUDGET=800
